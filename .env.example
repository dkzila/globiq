# GlobIQ — Environment template
# Copy to .env and fill in your database connection string.
# Never commit real credentials (see repository security policy).

# PostgreSQL connection string (Supabase).
# Named GLOBIQ_DATABASE_URL on purpose: some environments inject a stale
# DATABASE_URL — this dedicated name is always under our control.
# Session pooler is recommended for development; direct connection works on Vercel.
GLOBIQ_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres
